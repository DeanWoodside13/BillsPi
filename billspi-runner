# Prefer IPv4 if IPv6 isn't usable (avoid AAAA/connect stalls on v4-only or broken v6 nets)
# 1) Decide if IPv6 is really usable: needs default route AND a quick successful HTTPS HEAD.
has_ipv6_usable() {
  ip -6 route show default >/dev/null 2>&1 || return 1
  # Try a fast IPv6 HEAD; call the system curl explicitly (pre-wrapper)
  if command -v /usr/bin/curl >/dev/null 2>&1; then
    /usr/bin/curl -6 -Is --max-time 2 https://deb.debian.org/ >/dev/null 2>&1
  else
    # If curl isn't present yet, don't block IPv6 just on that basis-assume usable.
    return 0
  fi
}

