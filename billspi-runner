# --- Network readiness helpers (centralized) ---

# Helper: default route?
have_route() {
  ip -4 route show default >/dev/null 2>&1 || ip -6 route show default >/dev/null 2>&1
}

# Helper: quick HTTPS HEAD via the real curl (avoid any wrapper)
head_ok() {
  command -v /usr/bin/curl >/dev/null 2>&1 && /usr/bin/curl -fsSI --max-time 2 https://deb.debian.org/ >/dev/null 2>&1
}

# Wait for usable network (bounded). Always returns 0 (non-blocking for callers).
wait_net() {
  # Fast path
  if have_route && head_ok; then return 0; fi

  # Prefer distro tools
  if command -v nm-online >/dev/null 2>&1; then
    nm-online -q --timeout=25 || true
  elif command -v dhcpcd >/dev/null 2>&1; then
    dhcpcd -w -t 25 || true
  else
    # Bounded fallback loop (<=25s)
    for _ in $(seq 1 25); do
      have_route || { sleep 1; continue; }
      head_ok && break
      sleep 1
    done
  fi

  return 0
}

# Cache the check (default TTL 120s) to avoid repeated probes on non-network phases
wait_net_if_needed() {
  [ -n "${BILLSPI_SKIP_WAIT_NET:-}" ] && return 0  # global escape hatch
  install -d -m0755 /run/billspi
  TTL=${BILLSPI_WAIT_NET_TTL:-120}

  # Invalidate cache if current network isn’t actually OK
  if ! have_route || ! head_ok; then
    rm -f /run/billspi/net-ok.stamp
  fi

  if [ -f /run/billspi/net-ok.stamp ]; then
    last=$(sed -n '1p' /run/billspi/net-ok.stamp 2>/dev/null || echo 0)
    now=$(date +%s)
    if [ $((now - last)) -lt "$TTL" ]; then
      return 0
    fi
  fi

  wait_net

  # Only stamp when connectivity is actually OK
  if have_route && head_ok; then
    date +%s > /run/billspi/net-ok.stamp
  fi
}


