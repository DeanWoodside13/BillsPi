set -Eeuo pipefail

readonly PHASEDIR="/usr/local/lib/billspi/phases"
readonly STATEDIR="/var/lib/billspi"
readonly STATEFILE="${STATEDIR}/current"
readonly LOGTAG="billspi-runner"
readonly LOGDIR="/var/log/billspi"
readonly LOGFILE="${LOGDIR}/install.log"

# One transcript writer per boot; the child keeps this guard across phase re-execs.
# Preserve normal stdout/HDMI output and capture stderr without enabling shell tracing.
if [[ "${BILLSPI_LOG_ACTIVE:-0}" != 1 ]]; then
    [[ ! -L "$LOGDIR" ]] || { echo "ERROR: log directory is a symlink." >&2; exit 1; }
    install -d -m0700 -o root -g root "$LOGDIR"
    [[ ! -L "$LOGFILE" && ( ! -e "$LOGFILE" || -f "$LOGFILE" ) ]] \
        || { echo "ERROR: unsafe installation log path." >&2; exit 1; }
    (umask 077; : >> "$LOGFILE")
    chown root:root "$LOGFILE"
    chmod 0600 "$LOGFILE"

    if BILLSPI_LOG_ACTIVE=1 /bin/bash "$0" "$@" 2>&1 | /usr/bin/tee --output-error=warn -a -- "$LOGFILE"; then
        log_status=("${PIPESTATUS[@]}")
    else
        log_status=("${PIPESTATUS[@]}")
    fi
    rc=${log_status[0]}
    if [[ ${log_status[1]} -ne 0 ]]; then
        echo "ERROR: installation output capture failed; inspect disk space and the journal." >&2
        [[ $rc -ne 0 && $rc -ne 200 ]] || rc=1
    fi
    if [[ $rc -ne 0 && $rc -ne 200 ]]; then
        /usr/bin/env -u LD_PRELOAD -u LD_LIBRARY_PATH /usr/bin/sync || true
        exit "$rc"
    fi

    # tee has drained: persist output before completion or an expected reboot.
    /usr/bin/env -u LD_PRELOAD -u LD_LIBRARY_PATH /usr/bin/journalctl --sync
    /usr/bin/env -u LD_PRELOAD -u LD_LIBRARY_PATH /usr/bin/sync
    if [[ $rc -eq 200 ]]; then
        systemctl reboot || reboot || shutdown -r now || true
    else
        install -D -m0644 /dev/null "${STATEDIR}/setup.done"
        systemctl disable billspi-setup.service || true
        /usr/bin/env -u LD_PRELOAD -u LD_LIBRARY_PATH /usr/bin/sync
    fi
    exit 0
fi

readonly BOOT_ID="$(cat /proc/sys/kernel/random/boot_id)"
log_event() {
    printf '[%s] [billspi] boot=%s %s\n' "$(/usr/bin/date -u '+%FT%TZ')" "$BOOT_ID" "$*"
}
