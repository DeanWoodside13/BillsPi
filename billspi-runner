# Ensure APT lists live on tmpfs during provisioning (idempotent)
ensure_apt_lists_tmpfs() {
  # Allow override via env; otherwise size based on RAM tiers
  if [ -n "${BILLSPI_APT_LISTS_TMPFS_SIZE_MB:-}" ]; then
    TMPFS_SIZE_MB="$BILLSPI_APT_LISTS_TMPFS_SIZE_MB"
  else
    TOTAL_MEM_KB=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
    if   [ "$TOTAL_MEM_KB" -ge 15000000 ]; then TMPFS_SIZE_MB=512   # ~16GB RAM
    elif [ "$TOTAL_MEM_KB" -ge  7500000 ]; then TMPFS_SIZE_MB=384   # ~8GB RAM
    elif [ "$TOTAL_MEM_KB" -ge  3500000 ]; then TMPFS_SIZE_MB=256   # ~4GB RAM
    else                                      TMPFS_SIZE_MB=192   # ~2GB RAM
    fi
  fi

  # redundant
  # install -d -m 0700 /var/lib/apt/lists/partial


  if ! mountpoint -q /var/lib/apt/lists; then
    # Not mounted yet - mount tmpfs with our cap
    mount -t tmpfs -o "size=${TMPFS_SIZE_MB}M,mode=0755,nodev,nosuid,noexec" tmpfs /var/lib/apt/lists
  else
    # Already a mountpoint; if it's tmpfs, optionally bump size (idempotent)
    if [ "$(findmnt -n -o FSTYPE /var/lib/apt/lists)" = "tmpfs" ]; then
      mount -o "remount,size=${TMPFS_SIZE_MB}M,mode=0755,nodev,nosuid,noexec" /var/lib/apt/lists || true
    else
      echo "WARN: /var/lib/apt/lists is mounted but not tmpfs; continuing on disk." >&2
    fi
  fi

  install -d -m 0700 /var/lib/apt/lists/partial
}


